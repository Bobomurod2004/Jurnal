      "options": {"cellHeight": "sm", "showHeader": true, "sortBy": [{"desc": true, "displayName": "Value"}]},
      "targets": [{"expr": "sum by (service, method, route, status_code) (increase(journal_http_requests_total{service=~\"${service:regex}\",route=~\"${route:regex}\",route!~\"/metrics|/healthz|/readyz\"}[$__range]))", "format": "table", "instant": true, "refId": "A"}],
      "title": "API route attempts and result codes", "transformations": [{"id": "labelsToFields", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {}, "renameByName": {"Value": "Attempts"}}}], "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never", "stacking": {"group": "A", "mode": "none"}}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 25}, "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "topk(15, histogram_quantile(0.95, sum by (le, service, method, route) (rate(journal_http_request_duration_seconds_bucket{service=~\"${service:regex}\",route=~\"${route:regex}\",route!~\"/metrics|/healthz|/readyz\"}[$__rate_interval]))))", "legendFormat": "{{service}} {{method}} {{route}}", "refId": "A"}],
      "title": "Slowest API endpoints — p95", "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 25}, "id": 9,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "showCommonLabels": true, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"expr": "{service=~\"${service:regex}\",level=~\"ERROR|CRITICAL\"}", "queryType": "range", "refId": "A"}],
      "title": "Application errors from Loki", "type": "logs"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": true}}, "overrides": []},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 34}, "id": 10,
      "options": {"cellHeight": "sm", "showHeader": true, "sortBy": [{"desc": false, "displayName": "route"}]},
      "targets": [{"expr": "journal_api_route_info{service=~\"${service:regex}\",route=~\"${route:regex}\"}", "format": "table", "instant": true, "refId": "A"}],
