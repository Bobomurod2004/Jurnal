      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "sum(increase(journal_http_requests_total{service=~\"${service:regex}\",status_code=~\"5..\",route!~\"/metrics|/healthz|/readyz\"}[$__range])) or vector(0)", "refId": "A"}],
      "title": "Server errors (5xx)", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(journal_http_request_duration_seconds_bucket{service=~\"${service:regex}\",route!~\"/metrics|/healthz|/readyz\"}[$__rate_interval]))) or vector(0)", "refId": "A"}],
      "title": "p95 API response time", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "stacking": {"group": "A", "mode": "none"}}}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4}, "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (service, method, route) (rate(journal_http_requests_total{service=~\"${service:regex}\",route=~\"${route:regex}\",route!~\"/metrics|/healthz|/readyz\"}[$__rate_interval]))", "legendFormat": "{{service}} {{method}} {{route}}", "refId": "A"}],
      "title": "Each API endpoint — request rate", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
