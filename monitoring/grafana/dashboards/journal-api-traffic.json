      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (service, status_code) (rate(journal_http_requests_total{service=~\"${service:regex}\",route=~\"${route:regex}\",route!~\"/metrics|/healthz|/readyz\"}[$__rate_interval]))", "legendFormat": "{{service}} HTTP {{status_code}}", "refId": "A"}],
      "title": "HTTP status distribution", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": true}, "unit": "short"}, "overrides": []},
