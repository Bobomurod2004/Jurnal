      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "sum(increase(journal_http_requests_total{service=~\"${service:regex}\",route!~\"/metrics|/healthz|/readyz\"}[$__range])) or vector(0)", "refId": "A"}],
      "title": "API attempts (selected period)", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "sum(increase(journal_http_requests_total{service=~\"${service:regex}\",status_code=~\"4..\",route!~\"/metrics|/healthz|/readyz\"}[$__range])) or vector(0)", "refId": "A"}],
      "title": "Client errors (4xx)", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
