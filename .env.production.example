DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-this-db-password
DB_NAME=journal2

FLASK_ENV=production
APP_HOST=journal.example.uz
APP_BASE_URL=https://journal.example.uz
APP_VERSION=1.0.1
LOG_LEVEL=INFO
IMAGE_REGISTRY=

SECRET_KEY=change-this-mainweb-secret
FMADMIN_SECRET_KEY=change-this-fmadmin-secret
TRANSLATION_SYNC_TOKEN=change-this-sync-token

# Static pages sync mode for db-init:
# overwrite   = update/create all baseline pages from code (DISCARDS fmadmin edits!)
# only-missing = create missing pages only (keep edited DB pages) — recommended
# skip        = do not sync baseline pages
PAGES_SYNC_MODE=only-missing

# Google OAuth (optional)
# Enable only after setting client ID/secret in Google Cloud Console.
# Callback URL must exactly match one of your Authorized redirect URIs.
# GOOGLE_AUTH_ENABLED=1
# GOOGLE_CLIENT_ID=change-this-google-client-id
# GOOGLE_CLIENT_SECRET=change-this-google-client-secret
# GOOGLE_REDIRECT_URI=https://journal.example.uz/auth/google/callback

# ORCID OAuth (optional)
# Use ORCID production (`https://orcid.org`) or sandbox (`https://sandbox.orcid.org`) as needed.
# ORCID_AUTH_ENABLED=1
# ORCID_CLIENT_ID=change-this-orcid-client-id
# ORCID_CLIENT_SECRET=change-this-orcid-client-secret
# ORCID_REDIRECT_URI=https://journal.example.uz/auth/orcid/callback
# ORCID_BASE_URL=https://orcid.org
# ORCID_SCOPE=/authenticate

# Real working SMTP option:
# Use the Gmail account as the authenticated sender.
# Keep the institutional mailbox as reply-to / contact recipient.
MAIL_ENABLED=1
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-this-smtp-user@example.com
MAIL_PASSWORD=change-this-smtp-password
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_FROM_EMAIL=change-this-from@example.com
MAIL_FROM_NAME=Philology Matters
MAIL_REPLY_TO=contact@example.com
MAIL_CONTACT_RECIPIENTS=contact@example.com

# Grafana (observability UI)
# GRAFANA_ADMIN_PASSWORD is REQUIRED: without it `docker compose ... up` for the
# observability stack stops before starting anything.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# How Grafana is reached. GRAFANA_ROOT_URL must match the address typed in the
# browser -- if it does not, Grafana loads but its redirects and assets point
# elsewhere and the UI only half works.
#
# Option A (recommended) -- behind the site's nginx at /grafana/, over TLS.
# Keep the port on 127.0.0.1 so port 3000 stays closed to the internet:
# GRAFANA_ROOT_URL=https://your-domain.uz/grafana/
# GRAFANA_SERVE_FROM_SUB_PATH=true
#
# Option B -- exposed directly on port 3000 (no TLS; prefer an SSH tunnel):
# GRAFANA_BIND_ADDR=0.0.0.0
# GRAFANA_ROOT_URL=http://your-server-ip:3000


# Observability
# Make plain `docker compose up/down/ps` include the observability stack too,
# so containers are not left behind when tearing the stack down:
# COMPOSE_FILE=docker-compose.yml:docker-compose.observability.yml
OBSERVABILITY_METRICS_ENABLED=1
# OTLP HTTP endpoint is injected by docker-compose.observability.yml.
# Keep tracing disabled unless the observability stack is running.
OTEL_TRACING_ENABLED=0
OTEL_SERVICE_NAMESPACE=journal

# Email verification code settings for registration
AUTH_EMAIL_CODE_LENGTH=6
AUTH_EMAIL_CODE_TTL_SECONDS=900
AUTH_EMAIL_CODE_RESEND_SECONDS=60
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5
AUTH_EMAIL_CODE_MAX_SENDS=5

# Editor assignment deadlines (hours).
# These are only the starting point. The assign form pre-fills them, and the
# flows without a form (auto-assign, re-review after a revision) fall back to
# them only when the submission has no earlier assignment to inherit from --
# whatever window an admin picked is carried into the following rounds.
# An unaccepted invitation is removed once the acceptance window passes, so
# raise this if reviewers routinely need longer to respond.
# EDITOR_ACCEPTANCE_DEFAULT_HOURS=24
# EDITOR_COMPLETION_DEFAULT_HOURS=120

# Optional one-time bootstrap for fmadmin super admin.
# If both values are set, db-init will create/update this account.
# SUPERADMIN_EMAIL=admin@example.com
# SUPERADMIN_NAME=Super Admin
# SUPERADMIN_PASSWORD=change-this-superadmin-password

# Optional: disable actual sending without changing code.
# MAIL_SUPPRESS_SEND=1
